# SwitchGate Lite Environment Configuration Example
# Copy this file to .env and configure your Switch server and LLM credentials.

# ── Switch Server Connection ──────────────────────────────────────────────────
SWITCH_SERVER_URL=http://127.0.0.1:8000
SWITCH_BIND_ADDR=127.0.0.1
API_HOST_PORT=8000
AGENT_REGISTRATION_TOKEN=your_switch_agent_registration_token_here
SWITCH_AGENT_TOKEN=your_switch_agent_registration_token_here

# ── Room Routing ─────────────────────────────────────────────────────────────
SWITCH_TRIAGE_ROOM_ID=incident-triage
SWITCH_APPROVAL_ROOM_ID=approval-vault
SWITCH_SINGLE_ROOM_MODE=false

# ── LLM Provider Configuration ───────────────────────────────────────────────
# Supported providers: sarvam (default), openai, nvidia
LLM_PROVIDER=sarvam
LLM_MODEL=sarvam-105b-conversations

# Provider API Keys (Set at least one):
SARVAM_API_KEY=your_sarvam_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
